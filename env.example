# Configuração para Desenvolvimento e Produção
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Banco de dados
DB_NAME=personalbudget
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=mySecretKey123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
JWT_EXPIRATION=86400000

# Frontend (Vite — embutido no docker build do frontend)
# Mesmo Client ID Web do Google Cloud (.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
