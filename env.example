# =========================
# Database
# =========================
DB_NAME=personalbudget
DB_USER=postgres
DB_PASSWORD=change-me

# =========================
# JWT
# =========================
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# =========================
# Frontend (Vercel/Vite)
# =========================
VITE_API_URL=http://localhost:8080
VITE_LOGO_DEV_TOKEN=

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379

# =========================
# Household reminders (inbox + push notifications)
# =========================

# Automatic cleaning reminders (Spring cron: second minute hour day month weekday)
HOUSEHOLD_CLEANING_ZONE=Europe/London
HOUSEHOLD_CLEANING_ASSIGNMENT_CRON=0 0 10 * * MON
HOUSEHOLD_CLEANING_INCOMPLETE_CRON=0 0 18 * * SUN

# Household payment reminders (Spring cron: second minute hour day month weekday)
HOUSEHOLD_PAYMENT_ZONE=Europe/London
HOUSEHOLD_PAYMENT_REMINDER_CRON=0 0 9 28,29,30 * *

# =========================
# Web Push (VAPID). Generate once (command in backend application.properties)
# and never change the pair: that silently breaks every subscription.
# The private key is a secret. Never commit it.
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
