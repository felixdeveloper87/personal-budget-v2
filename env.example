# =========================
# Database
# =========================
DB_NAME=personalbudget
DB_USER=postgres
DB_PASSWORD=change-me

# =========================
# JWT
# =========================
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# =========================
# Google OAuth
# =========================
GOOGLE_OAUTH_CLIENT_ID=

# =========================
# Frontend (Vercel/Vite)
# =========================
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=http://localhost:8080
VITE_LOGO_DEV_TOKEN=

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379

# =========================
# Outbound e-mail (Resend)
# Use an address/domain verified in Resend. Never commit the API key.
# =========================
RESEND_API_KEY=
RESEND_FROM_EMAIL=Personal Budget <updates@your-verified-domain.example>
