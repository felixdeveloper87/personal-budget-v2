        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml Personal Budget - System Architecture\n!theme aws-orange\nskinparam componentStyle rectangle\nskinparam shadowing true\nskinparam roundcorner 10\nskinparam defaultFontSize 11\nskinparam defaultFontName Arial\n\ntitle &lt;size:20&gt;&lt;b&gt;Personal Budget - System Architecture&lt;/b&gt;&lt;/size&gt;\n\npackage \&quot;🌍 CDN Layer\&quot; #E3F2FD {\n  component [&lt;color:#1565C0&gt;&lt;b&gt;Cloudflare&lt;/b&gt;&lt;/color&gt;\\n━━━━━━━━━━━━━━━━━━\\nCDN • DDoS Protection\\nSSL Termination\\nCaching\\n━━━━━━━━━━━━━━━━━━\\n📍 Global Edge] as Cloudflare #BBDEFB\n}\n\npackage \&quot;🌐 Frontend Layer\&quot; #E8F5E9 {\n  component [&lt;color:#2E7D32&gt;&lt;b&gt;React Frontend&lt;/b&gt;&lt;/color&gt;\\n━━━━━━━━━━━━━━━━━━\\nTypeScript • Chakra UI\\nAxios • JWT Storage\\n━━━━━━━━━━━━━━━━━━\\n📍 Vercel] as React #C8E6C9\n}\n\npackage \&quot;🔒 Proxy Layer\&quot; #FFF3E0 {\n  component [&lt;color:#E65100&gt;&lt;b&gt;Nginx Reverse Proxy&lt;/b&gt;&lt;/color&gt;\\n━━━━━━━━━━━━━━━━━━\\nSSL/TLS • CORS\\nLoad Balancing\\n━━━━━━━━━━━━━━━━━━\\n📍 VPS] as Nginx #FFE0B2\n}\n\npackage \&quot;⚙️ Backend Layer\&quot; #F3E5F5 {\n  component [&lt;color:#6A1B9A&gt;&lt;b&gt;Spring Boot API&lt;/b&gt;&lt;/color&gt;\\n━━━━━━━━━━━━━━━━━━\\nSpring Security + JWT\\nSpring Data JPA\\nREST Controllers\\n━━━━━━━━━━━━━━━━━━\\n📍 Java 17 :8080] as SpringBoot #E1BEE7\n}\n\npackage \&quot;💾 Data Layer\&quot; #FCE4EC {\n  database [&lt;color:#C2185B&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/color&gt;\\n━━━━━━━━━━━━━━━━━━\\nUsers • Transactions\\nInstallment Plans\\n━━━━━━━━━━━━━━━━━━\\n📍 Version 16] as PostgreSQL #F8BBD0\n}\n\n&#39; Layout em duas colunas\nCloudflare -[#1565C0,thickness=2]-&gt; React : &lt;b&gt;HTTPS&lt;/b&gt;\nReact -[#2E7D32,thickness=2]-&gt; Nginx : &lt;b&gt;HTTPS&lt;/b&gt;\nNginx -[#E65100,thickness=2]-&gt; SpringBoot : &lt;b&gt;HTTP&lt;/b&gt;\nSpringBoot -[#6A1B9A,thickness=2]-&gt; PostgreSQL : &lt;b&gt;JPA&lt;/b&gt;\n\nnote right of Cloudflare\n  &lt;b&gt;CDN &amp; Security&lt;/b&gt;\n  • Global edge network\n  • DDoS protection\n  • SSL/TLS termination\n  • Static asset caching\nend note\n\nnote right of React\n  &lt;b&gt;Client Application&lt;/b&gt;\n  • Single Page Application\n  • JWT token storage\n  • Responsive UI\n  • Real-time updates\nend note\n\nnote right of Nginx\n  &lt;b&gt;Reverse Proxy&lt;/b&gt;\n  • Request routing\n  • CORS configuration\n  • SSL termination\n  • Load balancing\nend note\n\nnote right of SpringBoot\n  &lt;b&gt;API Backend&lt;/b&gt;\n  • RESTful endpoints\n  • JWT authentication\n  • Business logic\n  • Data validation\nend note\n\nnote right of PostgreSQL\n  &lt;b&gt;Database&lt;/b&gt;\n  • Relational data\n  • ACID compliance\n  • Indexed queries\n  • Data persistence\nend note\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="QieWkjA2j8J-14N9ygSj-1">
